<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1a1a2e">

    <!-- Title Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NPU LLM Chat"
            android:textSize="24sp"
            android:textColor="#e94560"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:visibility="gone"
            android:indeterminateTint="#e94560" />
    </LinearLayout>

    <!-- Status Bar -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Initializing..."
        android:textSize="12sp"
        android:textColor="#8b8b9e"
        android:paddingBottom="8dp" />

    <!-- Model Control -->
    <Button
        android:id="@+id/loadButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Load Model (NPU)"
        android:backgroundTint="#e94560"
        android:textColor="#ffffff"
        android:layout_marginBottom="12dp" />

    <!-- Chat Output -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#16213e"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/chatOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#eaeaea"
            android:fontFamily="monospace"
            android:text="Welcome to NPU LLM Chat!\n\nThis app uses Qualcomm Hexagon NPU for fast inference.\n\nClick 'Load Model' to begin.\n\n" />
    </ScrollView>

    <!-- Input Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/chatInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Type your message..."
            android:textColorHint="#6c6c8a"
            android:textColor="#eaeaea"
            android:backgroundTint="#16213e"
            android:paddingHorizontal="16dp"
            android:inputType="text"
            android:imeOptions="actionSend"
            android:singleLine="true" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="80dp"
            android:layout_height="48dp"
            android:text="Send"
            android:backgroundTint="#0f3460"
            android:textColor="#e94560"
            android:layout_marginStart="8dp"
            android:enabled="false" />
    </LinearLayout>

</LinearLayout>
