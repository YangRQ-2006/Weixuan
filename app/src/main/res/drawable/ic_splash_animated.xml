<?xml version="1.0" encoding="utf-8"?>
<!--
  微玄启动动画：「玄之门 · 水墨」
  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·  ·
  上游（Eta / Google AI 风格）版本是四色元素（green_circle / yellow_star /
  red_capsule / blue_clover）+ orbit 旋转的"缤纷 AI"动效，与「墨玄」体系完全冲突。
  这里改为：玄墨底上，一缕鎏金自下而上"写"出拱门（trimPath 擦除式描出），
  门内玄紫漩涡双环渐次显影，然后门心与两点星火亮起。
  全程只做「晕染 / 擦除 / 渐显」，不做旋转、不做弹跳 —— 这是微玄的"玄缓"。
-->
<animated-vector
    xmlns:aapt="http://schemas.android.com/aapt"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <aapt:attr name="android:drawable">
        <vector
            android:width="432dp"
            android:height="432dp"
            android:viewportWidth="432"
            android:viewportHeight="432">

            <!-- 拱门：从右下起笔，自下而上写出（trimPathEnd 0 -> 1） -->
            <path
                android:name="arch"
                android:pathData="M156,306 L156,214 C156,126 276,126 276,214 L276,306"
                android:strokeColor="#E8C56A"
                android:strokeWidth="7"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:trimPathStart="0"
                android:trimPathEnd="0" />

            <!-- 门内漩涡外环 -->
            <path
                android:name="swirl"
                android:pathData="M216,206 m-42,0 a42,42 0 1,0 84,0 a42,42 0 1,0 -84,0"
                android:strokeColor="#9B8CFF"
                android:strokeWidth="6"
                android:strokeLineCap="round"
                android:trimPathStart="0"
                android:trimPathEnd="0" />

            <!-- 门内漩涡内环（错峰显影） -->
            <path
                android:name="inner"
                android:pathData="M216,206 m-22,0 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0"
                android:strokeColor="#9B8CFF"
                android:strokeWidth="4"
                android:strokeLineCap="round"
                android:trimPathStart="0"
                android:trimPathEnd="0" />

            <!-- 门心（鎏金实心，渐显） -->
            <path
                android:name="core"
                android:pathData="M216,206 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0"
                android:fillColor="#E8C56A"
                android:fillAlpha="0" />

            <!-- 两点星火 -->
            <path
                android:name="star1"
                android:pathData="M144,150 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"
                android:fillColor="#E8C56A"
                android:fillAlpha="0" />
            <path
                android:name="star2"
                android:pathData="M292,136 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0"
                android:fillColor="#9B8CFF"
                android:fillAlpha="0" />
        </vector>
    </aapt:attr>

    <!-- 拱门：0 -> 560ms 自下而上描出 -->
    <target android:name="arch">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="560"
                android:startOffset="0"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:propertyName="trimPathEnd"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>

    <!-- 漩涡外环：140 -> 560ms -->
    <target android:name="swirl">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="420"
                android:startOffset="140"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:propertyName="trimPathEnd"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>

    <!-- 漩涡内环：280 -> 560ms -->
    <target android:name="inner">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="280"
                android:startOffset="280"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:propertyName="trimPathEnd"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>

    <!-- 门心：620 -> 820ms 渐显 -->
    <target android:name="core">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="200"
                android:startOffset="620"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:propertyName="fillAlpha"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>

    <!-- 星火 1：700 -> 900ms -->
    <target android:name="star1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="200"
                android:startOffset="700"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:propertyName="fillAlpha"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>

    <!-- 星火 2：760 -> 960ms -->
    <target android:name="star2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="200"
                android:startOffset="760"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:propertyName="fillAlpha"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
</animated-vector>
